# Copy this file to .env.feature on the server. Never commit .env.feature.
# Use only the dedicated development Telegram bot, never the production bot.
JOB_RADAR_TELEGRAM_BOT_TOKEN=
JOB_BEEPER_TELEGRAM_BOT_USERNAME=YourJobBeeperDevBot
JOB_BEEPER_TELEGRAM_WEBHOOK_SECRET=

# Optional Google OAuth beta signup credentials. Leave blank until configured.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
