# Copy this file to .env.feature on the server. Never commit .env.feature.
# Use only the dedicated development Telegram bot, never the production bot.
JOB_RADAR_TELEGRAM_BOT_TOKEN=
JOB_BEEPER_TELEGRAM_BOT_USERNAME=YourJobBeeperDevBot
JOB_BEEPER_TELEGRAM_WEBHOOK_SECRET=

# Optional Google OAuth beta signup credentials. Leave blank until configured.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# Reference-only Gmail settings. The port-8002 feature demo does not pass these to the app.
# Do not configure Gmail in this demo environment or reuse the member sign-in OAuth client.
# Use a localhost callback reached through an SSH local-port-forward tunnel.
JOB_RADAR_GMAIL_OAUTH_CLIENT_ID=
JOB_RADAR_GMAIL_OAUTH_CLIENT_SECRET=
JOB_RADAR_GMAIL_OAUTH_REDIRECT_URI=http://localhost:8080/api/integrations/google-alerts/gmail/callback
JOB_RADAR_GMAIL_OWNER_USER_ID=
JOB_RADAR_GMAIL_OWNER_EMAIL=
JOB_RADAR_GMAIL_TOKEN_ENCRYPTION_KEY=
JOB_RADAR_GMAIL_SYNC_MODE=polling
JOB_RADAR_GMAIL_POLL_INTERVAL_SECONDS=180
JOB_RADAR_GMAIL_ENABLE_LIVE_ACCESS=false  # Set true only after the private config preflight and explicit owner go-live action.
# Pub/Sub variables are intentionally unnecessary for polling mode.
